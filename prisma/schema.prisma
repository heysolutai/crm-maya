// ─── Integrations ───────────────────────────────────

/// Inbox = canal de comunicacao conectado (WhatsApp/Instagram/etc).
/// Antes chamado de WhatsappInstance. Cada inbox pode ter um AiAgent
/// vinculado (M:1 — varios inboxes podem compartilhar o mesmo agente).
model Inbox {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  instanceName    String    @map("instance_name")
  displayName     String?   @map("display_name")
  phoneNumber     String?   @map("phone_number")
  channelType     String    @default("uazapi") @map("channel_type")
  channelConfig   Json?     @default("{}") @map("channel_config")
  apiUrl          String?   @map("api_url")
  instanceApiKey  String?   @map("instance_api_key")
  adminToken      String?   @map("admin_token")
  status          String?   @default("disconnected")
  isActive        Boolean   @default(true) @map("is_active")
  qrCode          String?   @map("qr_code")
  errorMessage    String?   @map("error_message")
  lastConnectedAt DateTime? @map("last_connected_at")
  metadata        Json?     @default("{}")
  aiAgentId       String?   @map("ai_agent_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiAgent         AiAgent?         @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  reminders       Reminder[]
  followUpJobs    FollowUpJob[]
  catalogProducts CatalogProduct[]
  conversations   Conversation[]
  members         InboxMember[]
  leadDistributionStates LeadDistributionState[]

  @@index([companyId], map: "idx_inboxes_company")
  @@index([channelType], map: "idx_inboxes_channel")
  @@index([aiAgentId], map: "idx_inboxes_ai_agent")
  @@map("inboxes")
}

/// Configuracoes globais do sistema editaveis em runtime via super-admin.
/// Substitui variaveis de ambiente que precisam mudar sem restart
/// (URLs de webhook do N8N, chaves API default, etc).
///
/// Nome da tabela e `system_config` pra nao colidir com `system_settings`
/// que e a tabela singleton de branding/aparencia.
model SystemConfig {
  key         String   @id
  value       String?
  description String?
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_config")
}

/// Credenciais reutilizaveis pra cada canal por empresa.
/// Salvas na 1a vez que o usuario cria um agente (UazAPI/Evolution/etc) e
/// pre-preenchidas em criacoes seguintes — evita digitar admin token toda vez.
model ChannelCredential {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  channelType  String   @map("channel_type")
  serverUrl    String   @map("server_url")
  serverApiKey String   @map("server_api_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, channelType], map: "uq_channel_credentials_company_type")
  @@index([companyId], map: "idx_channel_credentials_company")
  @@map("channel_credentials")
}

model CatalogProduct {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  instanceId      String?   @map("instance_id") @db.Uuid
  waProductId     String    @map("wa_product_id")       // ID do produto no WhatsApp
  name            String
  description     String?
  price           String?                                // Formatado (ex: R$ 19.900,00)
  priceAmount     String?   @map("price_amount")         // Raw amount da API (ex: "19900000")
  currency        String?   @default("BRL")
  availability    String?
  isHidden        Boolean   @default(false) @map("is_hidden")
  retailerId      String?   @map("retailer_id")
  url             String?
  images          Json?     @default("[]")               // Array de { id, originalUrl, thumbUrl }
  rawData         Json?     @map("raw_data")             // Objeto completo da UazAPI

  // Atributos estruturados flexíveis (extraídos/mapeados externamente, ex: via n8n).
  // Exemplos: motos {cc:250, brand:"Honda"}, óculos {color:"preto"}, celulares {storage:"256GB"}
  attributes      Json?     @default("{}")

  syncedAt        DateTime  @default(now()) @map("synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inbox   Inbox?  @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@unique([companyId, waProductId], map: "uq_catalog_company_product")
  @@index([companyId], map: "idx_catalog_company")
  @@map("catalog_products")
}

model GoogleCalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @unique @map("company_id") @db.Uuid
  calendarId      String?   @map("calendar_id")
