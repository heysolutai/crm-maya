  apiKeys           Json?    @default("{}") @map("api_keys")
  variables         Json?    @default("{}")
  knowledge         String?
  memoryKey         String?  @map("memory_key")
  productsKnowledge String?  @map("products_knowledge")
  n8nWebhookUrl     String?  @map("n8n_webhook_url")
  followUpEnabled   Boolean  @default(false) @map("follow_up_enabled")
  followUpStages    Json?    @default("[]") @map("follow_up_stages")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  inboxes Inbox[]

  @@index([companyId], map: "idx_ai_agents_company")
  @@index([isActive], map: "idx_ai_agents_active")
  @@map("ai_agents")
}

