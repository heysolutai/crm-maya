  totalTokens    Int      @default(0) @map("total_tokens")
  inputCost      Decimal  @default(0) @map("input_cost") @db.Decimal(10, 6)
  outputCost     Decimal  @default(0) @map("output_cost") @db.Decimal(10, 6)
