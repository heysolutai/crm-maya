// ─── Analytics & System ─────────────────────────────

model AnalyticsDaily {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  date      DateTime @db.Date
  metrics   Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date], map: "idx_analytics_company_date")
  @@index([companyId], map: "idx_analytics_company")
  @@map("analytics_daily")
}

model DailyReport {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  reportDate            DateTime  @map("report_date") @db.Date
  crmEntries            Int       @default(0) @map("crm_entries")
  crmScheduled          Int       @default(0) @map("crm_scheduled")
  crmScheduledToday     Int       @default(0) @map("crm_scheduled_today")
  manualEntries         Int       @default(0) @map("manual_entries")
  manualScheduled       Int       @default(0) @map("manual_scheduled")
  manualScheduledToday  Int       @default(0) @map("manual_scheduled_today")
  manualAttended        Int       @default(0) @map("manual_attended")
  salesIds              String[]  @default([]) @map("sales_ids")
  salesTotal            Decimal   @default(0) @map("sales_total") @db.Decimal(12, 2)
  sentAt                DateTime? @map("sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_daily_reports_company")
  @@index([reportDate], map: "idx_daily_reports_date")
  @@map("daily_reports")
}

model SupportTicket {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  subject         String
  description     String?
  priority        String    @default("medium")
  status          String    @default("open")
  adminNotes      String?   @map("admin_notes")
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  screenshotPaths String[]  @default([]) @map("screenshot_paths")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User    @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  resolver User?   @relation("TicketResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_support_tickets_company")
  @@index([status], map: "idx_support_tickets_status")
  @@map("support_tickets")
}

model LeadDistributionState {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  departmentId       String?  @map("department_id") @db.Uuid
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_lead_dist_company")
  @@map("lead_distribution_state")
}

// ─── Departments & Pipelines ────────────────────────

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  color       String?  @default("#3b82f6")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members               DepartmentMember[]
  pipelines             Pipeline[]
  conversations         Conversation[]
  leadDistributionState LeadDistributionState[]

  @@index([companyId], map: "idx_departments_company")
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId], map: "idx_department_members_dept")
  @@index([userId], map: "idx_department_members_user")
  @@map("department_members")
}

model Pipeline {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String
  description  String?
  color        String?  @default("#3b82f6")
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  stages     PipelineStage[]
  clients    Client[]

  @@index([companyId], map: "idx_pipelines_company")
  @@index([departmentId], map: "idx_pipelines_department")
  @@map("pipelines")
}

model PipelineStage {
  id            String   @id @default(uuid()) @db.Uuid
  pipelineId    String   @map("pipeline_id") @db.Uuid
  name          String
  description   String?
  color         String?  @default("#3b82f6")
  orderPosition Int      @default(0) @map("order_position")
  isDefault     Boolean  @default(false) @map("is_default")
  isFinal       Boolean  @default(false) @map("is_final")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId], map: "idx_pipeline_stages_pipeline")
  @@map("pipeline_stages")
}
