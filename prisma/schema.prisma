}

// ─── AI & Knowledge ─────────────────────────────────

/// AiAgent = configuracao de IA reusavel (prompts, knowledge, integracoes).
/// Antes chamado de AiConfiguration. Pode ser referenciado por varios Inboxes
/// (relacao M:1 invertida — `Inbox.aiAgentId` aponta pra ca).
model AiAgent {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  createdBy         String?  @map("created_by") @db.Uuid
