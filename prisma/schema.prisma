generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────

enum AppRole {
  super_admin
  company_admin
  manager
  agent
  viewer
}

enum SubscriptionStatus {
  trial
  active
  suspended
  cancelled
}

enum CommunicationChannel {
  whatsapp
  telegram
  webchat
  instagram
  facebook
  email
  sms
}

enum ConversationStatus {
  active
  pending
  closed
}

enum SenderType {
  client
  ai
  agent
  system
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

// ─── Core ───────────────────────────────────────────

model Plan {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  price                  Decimal  @default(0) @db.Decimal(10, 2)
  billingCycle           String?  @default("monthly") @map("billing_cycle")
  maxClients             Int?     @map("max_clients")
  maxUsers               Int?     @map("max_users")
  maxAiConversations     Int?     @map("max_ai_conversations")
  features               Json?    @default("{}")
  description            String?
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  companies Company[]

  @@map("plans")
}

model Company {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  email                  String?
  tradeName              String?            @map("trade_name")
  phone                  String?
  address                Json?
  documentNumber         String?            @map("document_number")
  planId                 String?            @map("plan_id") @db.Uuid
  subscriptionStatus     SubscriptionStatus @default(trial) @map("subscription_status")
  subscriptionExpiresAt  DateTime?          @map("subscription_expires_at")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  isActive               Boolean            @default(true) @map("is_active")
  metadata               Json?              @default("{}")
  settings               Json?              @default("{}")
  whatsappInstanceName   String?            @map("whatsapp_instance_name")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at")

  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)

  users                  User[]
  userRoles              UserRole[]
  rolePermissions        RolePermission[]
  apiKeys                ApiKey[]
  funnelStages           FunnelStage[]
  clients                Client[]
  clientNotes            ClientNote[]
  conversations          Conversation[]
  conversationNotes      ConversationNote[]
  products               Product[]
  sales                  Sale[]
  appointments           Appointment[]
  reminders              Reminder[]
  followUpJobs           FollowUpJob[]
  inboxes                Inbox[]
  channelCredentials     ChannelCredential[]
  doctorSchedules        DoctorSchedule[]
  googleCalendarConn     GoogleCalendarConnection?
  aiAgents               AiAgent[]
  aiTokenUsage           AiTokenUsage[]
  companyFaqs            CompanyFaq[]
  analyticsDaily         AnalyticsDaily[]
  dailyReports           DailyReport[]
  supportTickets         SupportTicket[]
  leadDistributionState  LeadDistributionState[]
  departments            Department[]
  pipelines              Pipeline[]
  catalogProducts        CatalogProduct[]

  @@index([planId], map: "idx_companies_plan")
  @@index([isActive], map: "idx_companies_active")
  @@map("companies")
}

model SystemSettings {
  id                     String   @id @default("singleton")
  systemName             String   @default("Wyarp") @map("system_name")
  logoUrl                String?  @map("logo_url")
  faviconUrl             String?  @map("favicon_url")
  primaryColor           String   @default("217 91% 50%") @map("primary_color")
  secondaryColor         String   @default("217 70% 58%") @map("secondary_color")
  accentColor            String   @default("217 80% 38%") @map("accent_color")
  loginDescription       String?  @map("login_description")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique
  passwordHash           String?   @map("password_hash")
  fullName               String?   @map("full_name")
  avatarUrl              String?   @map("avatar_url")
  companyId              String?   @map("company_id") @db.Uuid
  phone                  String?
  isActive               Boolean   @default(true) @map("is_active")
  isOnline               Boolean   @default(false) @map("is_online")
  lastSeenAt             DateTime? @map("last_seen_at")
  lastLoginAt            DateTime? @map("last_login_at")
  lastLoginIp            String?   @map("last_login_ip")
  settings               Json?     @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  company                Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  userRoles              UserRole[]
  apiKeysCreated         ApiKey[]            @relation("ApiKeyCreator")
  clientsAssigned        Client[]            @relation("ClientAssignedTo")
  clientsCreated         Client[]            @relation("ClientCreatedBy")
  clientNotes            ClientNote[]
  clientFunnelMoves      ClientFunnelHistory[] @relation("FunnelMovedBy")
  conversationsTransferred Conversation[]    @relation("ConversationTransferredTo")
  messagesSent           Message[]
  messageReactions       MessageReaction[]
  conversationNotes      ConversationNote[]
  salesSold              Sale[]              @relation("SaleSoldBy")
  salesApproved          Sale[]              @relation("SaleApprovedBy")
  appointmentsAssigned   Appointment[]       @relation("AppointmentAssignedTo")
  appointmentsCancelled  Appointment[]       @relation("AppointmentCancelledBy")
  appointmentsCreated    Appointment[]       @relation("AppointmentCreatedBy")
  remindersCreated       Reminder[]
  aiAgentsCreated        AiAgent[]
  dailyReportsCreated    DailyReport[]
  supportTicketsCreated  SupportTicket[]     @relation("TicketCreator")
  supportTicketsResolved SupportTicket[]     @relation("TicketResolver")
  departmentMemberships  DepartmentMember[]
  inboxMemberships       InboxMember[]
  doctorSchedules        DoctorSchedule[]

  @@index([companyId], map: "idx_users_company")
  @@index([email], map: "idx_users_email")
  @@index([isOnline], map: "idx_users_is_online")
  @@map("users")
}

/// Log de eventos de seguranca: logins (ok/falha) e acessos a recursos
/// sensiveis (config de IA, API keys). Append-only, sem relacao (nao bloqueia
/// delete de usuario). Use pra auditar acessos estranhos.
model LoginLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  companyId String?  @map("company_id") @db.Uuid
  event     String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_login_logs_user")
  @@index([companyId, createdAt], map: "idx_login_logs_company_created")
  @@index([createdAt], map: "idx_login_logs_created")
  @@map("login_logs")
}

/// Reservas atribuidas (produto restaurante). O sistema de reservas e EXTERNO;
/// aqui so registramos pra metrica de valor (quantas a IA fez). A IA (via N8N)
/// ou o atendente cria um registro ao confirmar a reserva. source='ai' conta
/// no card "Reservas pela IA" do dashboard.
model Reservation {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  source         String    @default("ai")
  /// Tipo da reserva: 'normal' (mesa comum) ou 'evento' (evento personalizado).
  /// Default 'normal' pra que reservas ja existentes nao fiquem sem valor.
  type           String    @default("normal")
  customerName   String?   @map("customer_name")
  partySize      Int?      @map("party_size")
  reservedFor    DateTime? @map("reserved_for")
  status         String    @default("confirmed")
  notes          String?
  metadata       Json?     @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([companyId, createdAt], map: "idx_reservations_company_created")
  @@index([companyId, source], map: "idx_reservations_company_source")
  @@index([companyId, type], map: "idx_reservations_company_type")
  @@map("reservations")
}

/// Avaliacao do cliente sobre o atendimento/experiencia.
/// Criada pela IA (via n8n, com x-api-key) ao coletar a nota no WhatsApp, ou
/// pelo atendente manualmente. Os vinculos sao opcionais porque nem toda
/// avaliacao vem de uma conversa ou reserva conhecida.
model Review {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  reservationId  String?  @map("reservation_id") @db.Uuid
  /// Nota de 1 a 5
  rating         Int
  /// 'positivo' | 'neutro' | 'negativo'. Se nao vier na criacao, e derivado
  /// da nota (4-5 positivo, 3 neutro, 1-2 negativo). A IA pode sobrescrever
  /// quando o texto contradiz a nota.
  sentiment      String   @default("neutro")
  comment        String?
  customerName   String?  @map("customer_name")
  /// Origem do registro: 'ai' | 'agent' | 'manual'
  source         String   @default("ai")
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([companyId, createdAt], map: "idx_reviews_company_created")
  @@index([companyId, rating], map: "idx_reviews_company_rating")
  @@index([companyId, sentiment], map: "idx_reviews_company_sentiment")
  @@map("reviews")
}

/// Configuracoes do fluxo de avaliacao por empresa (1:1).
/// Links de avaliacao externa (Google/TripAdvisor), prompts que a IA usa pra
/// pedir a avaliacao e a saudacao inicial.
model ReviewSettings {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique @map("company_id") @db.Uuid
  /// Liga/desliga o modulo de avaliacao. Quem controla e o SUPER-ADMIN (a
  /// empresa nao ativa sozinha). Comeca desligado (opt-in). A cron diaria so
  /// dispara pro n8n quando este flag esta true (e o inbox tem restaurant_id).
  enabled        Boolean  @default(false)
  /// Hora do dia (0-23, fuso America/Sao_Paulo) em que a cron dispara a
  /// avaliacao desta empresa. A cron roda de hora em hora e so processa as
  /// empresas cujo dispatchHour bate com a hora atual.
  dispatchHour   Int      @default(9) @map("dispatch_hour")
  googleUrl      String?  @map("google_url")
  tripadvisorUrl String?  @map("tripadvisor_url")
  prompt1        String?
  prompt2        String?
  /// Saudacao inicial enviada ao pedir a avaliacao
  greeting       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("review_settings")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId], map: "idx_user_roles_unique")
  @@index([userId], map: "idx_user_roles_user")
  @@index([companyId], map: "idx_user_roles_company")
  @@map("user_roles")
}

model RolePermission {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  role                AppRole
  crmAccess           String   @default("full") @map("crm_access")
  salesAccess         String   @default("full") @map("sales_access")
  conversationAccess  String   @default("all") @map("conversation_access")
  appointmentsAccess  String   @default("full") @map("appointments_access")
  canEditSettings     Boolean  @default(false) @map("can_edit_settings")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role], map: "idx_role_permissions_unique")
  @@index([companyId], map: "idx_role_permissions_company")
  @@map("role_permissions")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  key         String    @unique
  keyHash     String?   @map("key_hash")
  keyPrefix   String?   @map("key_prefix") @db.VarChar(16)
  name        String?
  permissions Json?     @default("{}")
  isActive    Boolean   @default(true) @map("is_active")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_api_keys_company")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@map("api_keys")
}

// ─── Clients & Funnel ───────────────────────────────

model FunnelStage {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String
  description   String?
  color         String?  @default("#3b82f6")
  orderPosition Int      @default(0) @map("order_position")
  isDefault     Boolean  @default(false) @map("is_default")
  isFinal       Boolean  @default(false) @map("is_final")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients              Client[]
  clientFunnelHistory  ClientFunnelHistory[]

  @@index([companyId], map: "idx_funnel_stages_company")
  @@index([orderPosition], map: "idx_funnel_stages_order")
  @@map("funnel_stages")
}

model Client {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  fullName       String?   @map("full_name")
  email          String?
  phone          String?
  secondaryPhone String?   @map("secondary_phone")
  birthDate      DateTime? @map("birth_date") @db.Date
  gender         String?
  documentNumber String?   @map("document_number")
  avatarUrl      String?   @map("avatar_url")
  address        Json?
  source         String?
  tags           String[]  @default([])
  customFields   Json?     @default("{}") @map("custom_fields")
  assignedTo     String?   @map("assigned_to") @db.Uuid
  stageId        String?   @map("stage_id") @db.Uuid
  pipelineId     String?   @map("pipeline_id") @db.Uuid
  whatsappLid    String?   @map("whatsapp_lid")
  isActive       Boolean   @default(true) @map("is_active")
  aiPaused       Boolean   @default(false) @map("ai_paused")

  // Ad tracking fields (Meta/Facebook CTWA)
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  utmTerm        String?   @map("utm_term")
  adId           String?   @map("ad_id")
  adHeadline     String?   @map("ad_headline")
  adBody         String?   @map("ad_body")
  adMediaUrl     String?   @map("ad_media_url")
  adSourceUrl    String?   @map("ad_source_url")
  adPlatform     String?   @map("ad_platform")

  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedUser   User?        @relation("ClientAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  stage          FunnelStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  pipeline       Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  creator        User?        @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  notes          ClientNote[]
  funnelHistory  ClientFunnelHistory[]
  conversations  Conversation[]
  sales          Sale[]
  appointments   Appointment[]
  reminders      Reminder[]
  followUpJobs   FollowUpJob[]
  aiTokenUsage   AiTokenUsage[]

  @@index([companyId], map: "idx_clients_company")
  @@index([assignedTo], map: "idx_clients_assigned")
  @@index([stageId], map: "idx_clients_stage")
  @@index([phone], map: "idx_clients_phone")
  @@index([email], map: "idx_clients_email")
  @@index([whatsappLid], map: "idx_clients_whatsapp_lid")
  @@index([pipelineId], map: "idx_clients_pipeline")
  @@index([utmSource], map: "idx_clients_utm_source")
  @@index([adId], map: "idx_clients_ad_id")
  @@map("clients")
}

model ClientNote {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  note      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([clientId], map: "idx_client_notes_client")
  @@index([companyId], map: "idx_client_notes_company")
  @@map("client_notes")
}

model ClientFunnelHistory {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  enteredAt       DateTime  @default(now()) @map("entered_at")
  leftAt          DateTime? @map("left_at")
  durationMinutes Int?      @map("duration_minutes")
  movedBy         String?   @map("moved_by") @db.Uuid
  notes           String?

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stage  FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  mover  User?       @relation("FunnelMovedBy", fields: [movedBy], references: [id], onDelete: SetNull)

  @@index([clientId], map: "idx_client_funnel_history_client")
  @@index([stageId], map: "idx_client_funnel_history_stage")
  @@map("client_funnel_history")
}

// ─── Conversations & Messages ───────────────────────

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  clientId          String?            @map("client_id") @db.Uuid
  channel           CommunicationChannel @default(whatsapp)
  status            ConversationStatus @default(active)
  startedAt         DateTime?          @map("started_at")
  endedAt           DateTime?          @map("ended_at")
  durationSeconds   Int?               @map("duration_seconds")
  transferredTo     String?            @map("transferred_to") @db.Uuid
  aiHandled         Boolean            @default(false) @map("ai_handled")
  summary           String?
  tags              String[]           @default([])
  stage             String?
  satisfactionScore Int?               @map("satisfaction_score")
  friendlyId        String?            @map("friendly_id")
  metadata          Json?              @default("{}")
  departmentId      String?            @map("department_id") @db.Uuid
  inboxId           String?            @map("inbox_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transferAgent    User?             @relation("ConversationTransferredTo", fields: [transferredTo], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  inbox            Inbox?            @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  messages          Message[]
  conversationNotes ConversationNote[]
  reminders         Reminder[]
  followUpJobs      FollowUpJob[]
  aiTokenUsage      AiTokenUsage[]

  @@index([companyId], map: "idx_conversations_company")
  @@index([companyId, status], map: "idx_conversations_company_status")
  @@index([clientId, status], map: "idx_conversations_client_status")
  @@index([clientId], map: "idx_conversations_client")
  @@index([status], map: "idx_conversations_status")
  @@index([channel], map: "idx_conversations_channel")
  @@index([createdAt], map: "idx_conversations_created")
  @@index([departmentId], map: "idx_conversations_department")
  @@index([inboxId], map: "idx_conversations_inbox")
  @@map("conversations")
}

model Message {
  id              String     @id @default(uuid()) @db.Uuid
  conversationId  String     @map("conversation_id") @db.Uuid
  messageText     String?    @map("message_text")
  messageType     String?    @default("text") @map("message_type")
  senderId        String?    @map("sender_id") @db.Uuid
  senderType      SenderType @default(client) @map("sender_type")
  mediaUrl        String?    @map("media_url")
  quotedMessageId String?    @map("quoted_message_id")
  isRead          Boolean    @default(false) @map("is_read")
  readAt          DateTime?  @map("read_at")
  readStatus      String?    @map("read_status")
  aiConfidence    Decimal?   @map("ai_confidence") @db.Decimal(5, 4)
  intentDetected  String?    @map("intent_detected")
  sentiment       String?
  metadata        Json?      @default("{}")
  uazMessageId    String?    @unique(map: "uq_messages_uaz_message_id") @map("uaz_message_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reactions    MessageReaction[]
  aiTokenUsage AiTokenUsage[]

  @@index([conversationId], map: "idx_messages_conversation")
  @@index([conversationId, createdAt], map: "idx_messages_conv_created")
  @@index([senderId], map: "idx_messages_sender")
  @@index([createdAt], map: "idx_messages_created")
  @@map("messages")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId], map: "idx_push_subscriptions_user")
  @@index([companyId], map: "idx_push_subscriptions_company")
  @@map("push_subscriptions")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

