}

// ─── Integrations ───────────────────────────────────

model WhatsappInstance {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @unique @map("company_id") @db.Uuid
  instanceName    String    @map("instance_name")
  apiUrl          String?   @map("api_url")
  instanceApiKey  String?   @map("instance_api_key")
  adminToken      String?   @map("admin_token")
  status          String?   @default("disconnected")
  isActive        Boolean   @default(true) @map("is_active")
  qrCode          String?   @map("qr_code")
  errorMessage    String?   @map("error_message")
  lastConnectedAt DateTime? @map("last_connected_at")
  metadata        Json?     @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiConfigurations AiConfiguration[]
  reminders        Reminder[]
  followUpJobs     FollowUpJob[]

  @@index([companyId], map: "idx_whatsapp_instances_company")
  @@map("whatsapp_instances")
}

model GoogleCalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @unique @map("company_id") @db.Uuid
  calendarId      String?   @map("calendar_id")
  calendarName    String?   @map("calendar_name")
  connectedEmail  String?   @map("connected_email")
  accessToken     String?   @map("access_token")
  refreshToken    String?   @map("refresh_token")
  tokenExpiresAt  DateTime? @map("token_expires_at")
  syncEnabled     Boolean   @default(false) @map("sync_enabled")
  createMeetLinks Boolean   @default(false) @map("create_meet_links")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_google_calendar_company")
  @@map("google_calendar_connections")
}

// ─── AI & Knowledge ─────────────────────────────────

model AiConfiguration {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  createdBy          String?  @map("created_by") @db.Uuid
  name               String?
  prompts            Json?    @default("{}")
  behaviorSettings   Json?    @default("{}") @map("behavior_settings")
  conditions         Json?    @default("{}")
  apiKeys            Json?    @default("{}") @map("api_keys")
  variables          Json?    @default("{}")
  knowledge          String?
  memoryKey          String?  @map("memory_key")
  whatsappInstanceId String?  @map("whatsapp_instance_id") @db.Uuid
  n8nWebhookUrl      String?  @map("n8n_webhook_url")
  followUpEnabled    Boolean  @default(false) @map("follow_up_enabled")
  followUpStages     Json?    @default("[]") @map("follow_up_stages")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator          User?             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_ai_config_company")
  @@index([isActive], map: "idx_ai_config_active")
  @@map("ai_configurations")
}

model AiTokenUsage {
