# ============================================================
#  CRM Maya — Variaveis de ambiente
# ============================================================
#  Copie este arquivo para .env e preencha os valores reais.
#  O .env e ignorado pelo git (ver .gitignore) — nunca commit.
#
#  O comando `./deploy.sh setup` na VPS gera automaticamente um
#  .env com DATABASE_URL, REDIS_URL e secrets aleatorios. Os
#  campos opcionais (B2, OpenAI, Google, etc) precisam ser
#  preenchidos manualmente depois.
# ============================================================


# ----------- OBRIGATORIAS PARA RODAR --------------------------

# Banco PostgreSQL (criado pelo deploy.sh setup)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_wyarp"

# Redis (BullMQ + SSE)
REDIS_URL="redis://localhost:6379"

# Postgres VETORIAL (separado do principal) — base de FAQ pra busca semantica.
# Precisa ter a extensao pgvector instalada (ex: imagem pgvector/pgvector:pg16).
# Cria UMA TABELA POR EMPRESA: faq_<company_id>, no formato LangChain/n8n
# (colunas: id, text, metadata, vector) pra o n8n consultar sem config extra.
# Se ficar vazio, a indexacao e simplesmente pulada (FAQ continua funcionando).
VECTOR_DATABASE_URL=""
VECTOR_DB_POOL_MAX="5"

# URL publica da aplicacao
NEXTAUTH_URL="https://crm.seudominio.com.br"
NEXT_PUBLIC_APP_URL="https://crm.seudominio.com.br"

# Secrets (gere com: openssl rand -base64 32 / openssl rand -hex 32)
NEXTAUTH_SECRET="GERE_COM_openssl_rand_base64_32"
INTERNAL_API_SECRET="GERE_COM_openssl_rand_hex_32"
CRON_SECRET="GERE_COM_openssl_rand_hex_32"

# Atras de reverse proxy (nginx) — sem isso, NextAuth recusa Host header
AUTH_TRUST_HOST=true


# ----------- STORAGE (Backblaze B2) ---------------------------
# Necessario pra mensagens com midia (audio, imagem, video, doc)

B2_KEY_ID="seu_key_id_b2"
B2_APP_KEY="seu_app_key_b2"
B2_BUCKET_NAME="crm-media"
B2_BUCKET_REGION="us-west-004"
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_PUBLIC_URL="https://crm-media.s3.us-west-004.backblazeb2.com"


# ----------- IA / OPENAI --------------------------------------
# Opcional. Habilita transcricao de audio recebido + agente IA

DEFAULT_OPENAI_API_KEY=""

# Encripta as chaves de API que cada empresa salva no painel
# (gere com: openssl rand -hex 32)
API_KEY_ENCRYPTION_SECRET="GERE_COM_openssl_rand_hex_32"


# ----------- WHATSAPP (UAZapi) --------------------------------
# Configurada por instancia no painel da empresa.
# Esses valores sao apenas defaults globais.

UAZAPI_BASE_URL="https://uazapi.heysolut.com.br"
WHATSAPP_ADMIN_TOKEN=""


# ----------- N8N (automacoes externas) ------------------------
# Opcional. Empresa pode configurar webhook proprio no painel.

N8N_AI_WEBHOOK_URL=""
N8N_FAQ_UPLOAD_WEBHOOK_URL=""
NEXT_PUBLIC_N8N_FAQ_WEBHOOK_URL=""
KNOWLEDGE_WEBHOOK_URL=""
EXTERNAL_WEBHOOK_URL=""

# Cron diaria de avaliacoes: pra onde o sistema dispara { apikey, restaurant_id }
# 1x/dia, por restaurante com o modulo de avaliacao ativo. Pode ser sobrescrito
# no painel super-admin pela system setting 'n8n_review_webhook_url'.
N8N_REVIEW_WEBHOOK_URL=""
# Horario/timezone da cron de avaliacoes (default: 09:00 America/Sao_Paulo).
# REVIEW_DISPATCH_CRON="0 9 * * *"
# REVIEW_DISPATCH_TZ="America/Sao_Paulo"


# ----------- GOOGLE OAUTH (calendar/login) --------------------
# Opcional. So necessario se for habilitar Google Calendar sync
# ou login social.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ----------- WEB PUSH NOTIFICATIONS (PWA) ---------------------
# Opcional. Habilita notificacao no celular do atendente quando
# nao esta com a aba aberta.
# Gere com: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@seudominio.com.br"


# ----------- AVANCADO -----------------------------------------

# Origens extras pra CORS (separadas por virgula).
# Por padrao so NEXTAUTH_URL e permitido.
CORS_EXTRA_ORIGINS=""

# Pool do Postgres (defaults: min=2, max=10)
DB_POOL_MIN="2"
DB_POOL_MAX="10"

# Modo de execucao (Next.js gerencia automatico — nao mexa em prod)
# NODE_ENV="production"
