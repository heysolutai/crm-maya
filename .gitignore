# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/supabase/.temp/cli-latest
supabase/supabase/.temp/gotrue-version
supabase/supabase/.temp/postgres-version
supabase/supabase/.temp/project-ref
supabase/supabase/.temp/pooler-url
supabase/supabase/.temp/rest-version
supabase/supabase/.temp/storage-migration
supabase/supabase/.temp/storage-version

/src/generated/prisma

# Service worker gerado pelo Serwist
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# Documentação local (não versionada)
/docs

# Outputs locais de tools (graphify, security-review)
/graphify-out
/graphify-out.zip
/src/graphify-out
/security-review-out
